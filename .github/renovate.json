{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>aonyx-ai/renovate-config"],

  // A composite action pins the version of mise that `jdx/mise-action`
  // installs, and no manager of Renovate reads an input of an action. The
  // manager below takes the annotation that the pin carries, in the format
  // that the presets of Renovate use for a version that a comment describes.
  // It reads the composite actions and the workflows, because a pin that
  // carries the annotation can sit in either.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/actions/*/action.yml",
        ".github/workflows/*.yml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+version: [\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    },

    // `mise.toml` pins the nightly toolchain by its date, and no manager of
    // Renovate knows that form. The manager below moves the date in
    // `mise.toml` and in `mise.lock` together, because an install with
    // `--locked` refuses a pin that the lockfile does not hold. The lockfile
    // cannot carry an annotation, so the manager matches the name of the
    // toolchain instead.
    {
      "customType": "regex",
      "managerFilePatterns": ["mise.toml", "mise.lock"],
      "matchStrings": ["nightly-(?<currentValue>\\d{4}-\\d{2}-\\d{2})"],
      "depNameTemplate": "rust-nightly",
      "datasourceTemplate": "custom.rust-nightly",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    }
  ],

  // A nightly that lacks rustfmt is useless to `format-rust`, and some
  // nightlies ship without it. The history of the components of rustup names
  // the newest nightly that carries rustfmt, so the datasource offers that
  // one.
  "customDatasources": {
    "rust-nightly": {
      "defaultRegistryUrlTemplate": "https://rust-lang.github.io/rustup-components-history/x86_64-unknown-linux-gnu/rustfmt.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": [{ \"version\": last_available }] }"
      ]
    }
  },

  // A new nightly appears every day, and a pull request for each would be
  // noise, so the pin moves once a week.
  "packageRules": [
    {
      "matchDepNames": ["rust-nightly"],
      "extends": ["schedule:weekly"]
    }
  ]
}
