{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>aonyx-ai/renovate-config"],

  // The workflows pin the version of mise that `jdx/mise-action` installs, and
  // no manager of Renovate reads an input of an action. The manager below
  // takes the annotation that the pin carries, in the format that the presets
  // of Renovate use for a version that a comment describes.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+version: [\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    }
  ]
}
