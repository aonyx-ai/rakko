// Tracey links the requirements in the specifications to the code that
// implements them and to the tests that verify them. Each crate has its own
// specification and its own entry below, so that coverage is reported per
// crate. See https://tracey.bearcove.eu/ for the configuration reference.
@schema {id crate:tracey-config@1, cli tracey}

specs (
    {
        name rakko
        source_url https://github.com/aonyx-ai/rakko
        include (crates/rakko/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/rakko/src/**/*.rs)
                test_include (crates/rakko/tests/**/*.rs)
            }
        )
    }
    {
        name action
        source_url https://github.com/aonyx-ai/rakko
        include (crates/rakko-action/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/rakko-action/src/**/*.rs)
                test_include (crates/rakko-action/tests/**/*.rs)
            }
        )
    }
    {
        name cli
        source_url https://github.com/aonyx-ai/rakko
        include (crates/rakko-cli/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/rakko-cli/src/**/*.rs)
                test_include (crates/rakko-cli/tests/**/*.rs)
            }
        )
    }
    {
        name format-toml
        source_url https://github.com/aonyx-ai/rakko
        include (crates/rakko-format-toml/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/rakko-format-toml/src/**/*.rs)
                test_include (crates/rakko-format-toml/tests/**/*.rs)
            }
        )
    }
    {
        name lint-toml
        source_url https://github.com/aonyx-ai/rakko
        include (crates/rakko-lint-toml/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/rakko-lint-toml/src/**/*.rs)
                test_include (crates/rakko-lint-toml/tests/**/*.rs)
            }
        )
    }
    {
        name taplo
        source_url https://github.com/aonyx-ai/rakko
        include (crates/rakko-taplo/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/rakko-taplo/src/**/*.rs)
                test_include (crates/rakko-taplo/tests/**/*.rs)
            }
        )
    }
    {
        name tool
        source_url https://github.com/aonyx-ai/rakko
        include (crates/rakko-tool/SPECIFICATION.md)
        impls (
            {
                name rust
                include (crates/rakko-tool/src/**/*.rs)
                test_include (crates/rakko-tool/tests/**/*.rs)
            }
        )
    }
)
